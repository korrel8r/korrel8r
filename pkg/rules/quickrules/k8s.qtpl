# ClusterInstanceToOperands finds operands of cluster-scoped instances whose app.kubernetes.io/instance label matches the start object's name.
name: ClusterInstanceToOperands
start:
  domain: k8s
goal:
  domain: k8s
  classes:
    - ClusterRole.rbac.authorization.k8s.io
    - ClusterRoleBinding.rbac.authorization.k8s.io
    - Deployment.apps
    - DaemonSet.apps
    - StatefulSet.apps
    - ReplicaSet.apps
    - Service
    - ConfigMap
    - Secret
    - ServiceAccount
    - PersistentVolumeClaim
    - Job.batch
    - CronJob.batch
    - Role.rbac.authorization.k8s.io
    - RoleBinding.rbac.authorization.k8s.io
    - Ingress.networking.k8s.io
    - NetworkPolicy.networking.k8s.io
    - Route.v1.route.openshift.io

{% func ClusterInstanceToOperands(o interface{}) %}
{% code
	obj, _, ns, name, _ := k8sMetadata(o)
	if ns != "" { Fail("namespaced object") }
	RequireAll(name)
	if !isCustomResource(obj) { Fail("not a custom resource") }
%}
k8s:ClusterRole.rbac.authorization.k8s.io:{"labels":{"app.kubernetes.io/instance":{%q= name %}}}
k8s:ClusterRoleBinding.rbac.authorization.k8s.io:{"labels":{"app.kubernetes.io/instance":{%q= name %}}}
