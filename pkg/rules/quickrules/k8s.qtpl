goal:
  domain: k8s
  classes: [StorageClass.storage.k8s.io]

{% func PVCToStorageClass(o interface{}) %}
{% code
	obj := o.(map[string]any)
	sc := Require(obj["spec"].(map[string]any)["storageClassName"].(string))
%}
k8s:StorageClass.storage.k8s.io:{"name":{%q= sc %}}
{% endfunc %}

# SubscriptionToCSV finds the ClusterServiceVersion for an OLM Subscription.
name: SubscriptionToCSV
start:
  domain: k8s
  classes: [Subscription.v1alpha1.operators.coreos.com]
goal:
  domain: k8s
  classes: [ClusterServiceVersion.v1alpha1.operators.coreos.com]

{% func SubscriptionToCSV(o interface{}) %}
{% code
	obj := o.(map[string]any)
	csv := Require(obj["status"].(map[string]any)["currentCSV"].(string))
%}
k8s:ClusterServiceVersion.v1alpha1.operators.coreos.com:{"name":{%q= csv %}}
{% endfunc %}

# CSVToCRD finds CustomResourceDefinitions owned by a ClusterServiceVersion.
name: CSVToCRD
start:
  domain: k8s
  classes: [ClusterServiceVersion.v1alpha1.operators.coreos.com]
goal:
  domain: k8s
  classes: [CustomResourceDefinition.v1.apiextensions.k8s.io]

{% func CSVToCRD(o interface{}) %}
{% code
	obj := o.(map[string]any)
	owned := mapSlice(obj["spec"].(map[string]any)["customresourcedefinitions"].(map[string]any), "owned")
%}
{% for _, item := range owned %}
{% code crd := item.(map[string]any) %}
k8s:CustomResourceDefinition.apiextensions.k8s.io:{"name":{%q= crd["name"].(string) %}}
{% endfor %}
{% endfunc %}

# CRDToInstances finds instances of a CustomResourceDefinition.
name: CRDToInstances
start:
  domain: k8s
  classes: [CustomResourceDefinition.apiextensions.k8s.io]
goal:
  domain: k8s

{% func CRDToInstances(o interface{}) %}
{% code
	obj := o.(map[string]any)
	spec := obj["spec"].(map[string]any)
	kind := spec["names"].(map[string]any)["kind"].(string)
	version := mapSlice(spec, "versions")[0].(map[string]any)["name"].(string)
	group := spec["group"].(string)
%}
k8s:{%s= kind %}.{%s= version %}.{%s= group %}:{}
{% endfunc %}

# CSVToDeployment finds Deployments installed by a ClusterServiceVersion.
name: CSVToDeployment
start:
  domain: k8s
  classes: [ClusterServiceVersion.v1alpha1.operators.coreos.com]
goal:
  domain: k8s
  classes: [Deployment.apps]

{% func CSVToDeployment(o interface{}) %}
{% code
	_, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	obj := o.(map[string]any)
	deployments := mapSlice(obj["spec"].(map[string]any)["install"].(map[string]any)["spec"].(map[string]any), "deployments")
%}
{% for _, d := range deployments %}
{% code dep := d.(map[string]any) %}
k8s:Deployment.apps:{"namespace":{%q= ns %},"name":{%q= dep["name"].(string) %}}
{% endfor %}
{% endfunc %}

# SubscriptionToInstallPlan finds the InstallPlan for an OLM Subscription.
name: SubscriptionToInstallPlan
start:
  domain: k8s
  classes: [Subscription.v1alpha1.operators.coreos.com]
goal:
  domain: k8s
  classes: [InstallPlan.v1alpha1.operators.coreos.com]

{% func SubscriptionToInstallPlan(o interface{}) %}
{% code
	obj := o.(map[string]any)
	ref := obj["status"].(map[string]any)["installPlanRef"].(map[string]any)
%}
k8s:InstallPlan.v1alpha1.operators.coreos.com:{"namespace":{%q= ref["namespace"].(string) %},"name":{%q= ref["name"].(string) %}}
{% endfunc %}

# InstallPlanToCSV finds ClusterServiceVersions from an InstallPlan.
name: InstallPlanToCSV
start:
  domain: k8s
  classes: [InstallPlan.v1alpha1.operators.coreos.com]
goal:
  domain: k8s
  classes: [ClusterServiceVersion.v1alpha1.operators.coreos.com]

{% func InstallPlanToCSV(o interface{}) %}
{% code
	_, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	obj := o.(map[string]any)
	names := mapSlice(obj["spec"].(map[string]any), "clusterServiceVersionNames")
%}
{% for _, n := range names %}
k8s:ClusterServiceVersion.v1alpha1.operators.coreos.com:{"namespace":{%q= ns %},"name":{%q= n.(string) %}}
{% endfor %}
{% endfunc %}

# SubscriptionToCatalogSource finds the CatalogSource for an OLM Subscription.
name: SubscriptionToCatalogSource
start:
  domain: k8s
  classes: [Subscription.v1alpha1.operators.coreos.com]
goal:
  domain: k8s
  classes: [CatalogSource.v1alpha1.operators.coreos.com]

{% func SubscriptionToCatalogSource(o interface{}) %}
{% code
	obj := o.(map[string]any)
	spec := obj["spec"].(map[string]any)
	srcNs := Require(spec["sourceNamespace"].(string))
	src := Require(spec["source"].(string))
%}
k8s:CatalogSource.v1alpha1.operators.coreos.com:{"namespace":{%q= srcNs %},"name":{%q= src %}}
{% endfunc %}

# OperatorToCRD finds CRDs referenced by an OLM Operator.
name: OperatorToCRD
start:
  domain: k8s
  classes: [Operator.v1.operators.coreos.com]
goal:
  domain: k8s
  classes: [CustomResourceDefinition.apiextensions.k8s.io]

{% func OperatorToCRD(o interface{}) %}
{% code
	obj := o.(map[string]any)
	refs := mapSlice(obj["status"].(map[string]any)["components"].(map[string]any), "refs")
%}
{% for _, r := range refs %}
{% code ref := r.(map[string]any) %}
{% if ref["kind"].(string) == "CustomResourceDefinition" %}
k8s:CustomResourceDefinition.apiextensions.k8s.io:{"name":{%q= ref["name"].(string) %}}
{% endif %}
{% endfor %}
{% endfunc %}

# OperatorToCSV finds ClusterServiceVersions referenced by an OLM Operator.
name: OperatorToCSV
start:
  domain: k8s
  classes: [Operator.v1.operators.coreos.com]
goal:
  domain: k8s
  classes: [ClusterServiceVersion.v1alpha1.operators.coreos.com]

{% func OperatorToCSV(o interface{}) %}
{% code
	obj := o.(map[string]any)
	refs := mapSlice(obj["status"].(map[string]any)["components"].(map[string]any), "refs")
%}
{% for _, r := range refs %}
{% code ref := r.(map[string]any) %}
{% if ref["kind"].(string) == "ClusterServiceVersion" %}
k8s:ClusterServiceVersion.v1alpha1.operators.coreos.com:{"namespace":{%q= ref["namespace"].(string) %},"name":{%q= ref["name"].(string) %}}
{% endif %}
{% endfor %}
{% endfunc %}

# OperatorToSubscription finds Subscriptions referenced by an OLM Operator.
name: OperatorToSubscription
start:
  domain: k8s
  classes: [Operator.v1.operators.coreos.com]
goal:
  domain: k8s
  classes: [Subscription.v1alpha1.operators.coreos.com]

{% func OperatorToSubscription(o interface{}) %}
{% code
	obj := o.(map[string]any)
	refs := mapSlice(obj["status"].(map[string]any)["components"].(map[string]any), "refs")
%}
{% for _, r := range refs %}
{% code ref := r.(map[string]any) %}
{% if ref["kind"].(string) == "Subscription" %}
k8s:Subscription.v1alpha1.operators.coreos.com:{"namespace":{%q= ref["namespace"].(string) %},"name":{%q= ref["name"].(string) %}}
