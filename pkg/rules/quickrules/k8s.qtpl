%}
k8s:StorageClass.storage.k8s.io:{"name":{%q= sc %}}
{% endfunc %}

# PVCToStorageClass finds the StorageClass for a PersistentVolumeClaim.
name: PVCToStorageClass
start:
  domain: k8s
