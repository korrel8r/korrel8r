{% package quickrules %}

{% import "github.com/korrel8r/korrel8r/pkg/domains/k8s" %}
{% import "k8s.io/apimachinery/pkg/runtime/schema" %}
{% import "strings" %}

# DependentToOwner follows the first ownerReference of any k8s object to its owner.
name: DependentToOwner
start:
  domain: k8s
goal:
  domain: k8s

{% func DependentToOwner(o interface{}) %}
{% code
	obj := o.(map[string]any)
	metadata := obj["metadata"].(map[string]any)
	ref := mapSlice(metadata, "ownerReferences")[0].(map[string]any)
	apiVersion := ref["apiVersion"].(string)
	kind := ref["kind"].(string)
	name := ref["name"].(string)
	class := k8s.Class(schema.FromAPIVersionAndKind(apiVersion, kind))
	ns, _ := metadata["namespace"].(string)
%}
{% if class.Namespaced() && ns != "" %}
k8s:{%s= class.Name() %}:{"namespace":{%q= ns %},"name":{%q= name %}}
{% else %}
k8s:{%s= class.Name() %}:{"name":{%q= name %}}
{% endif %}
{% endfunc %}

# AllToEvent creates a k8s Event query to find events related to any k8s object.
name: AllToEvent
start:
  domain: k8s
goal:
  domain: k8s
  classes: [Event.]

{% func AllToEvent(o interface{}) %}
{% code
	_, _, ns, name, kind := k8sMetadata(o)
	apiVersion, _ := o.(map[string]any)["apiVersion"].(string)
	RequireAll(ns, name, kind, apiVersion)
%}
k8s:Event:{"namespace":{%q= ns %},"fields":{"involvedObject.apiVersion":{%q= apiVersion %},"involvedObject.kind":{%q= kind %},"involvedObject.name":{%q= name %},"involvedObject.namespace":{%q= ns %}}}
{% endfunc %}

# AllToMetric creates a metric query from any k8s object using namespace and kind.
name: AllToMetric
start:
  domain: k8s
goal:
  domain: metric
  classes: [metric]

{% func AllToMetric(o interface{}) %}
{% code
	_, _, ns, name, kind := k8sMetadata(o)
	RequireAll(ns, name, kind)
%}
metric:metric:{namespace={%q= ns %},{%s= strings.ToLower(kind) %}={%q= name %}}
{% endfunc %}

# SelectorToPods finds Pods matching the selector of a k8s workload resource.
name: SelectorToPods
start:
  domain: k8s
  classes:
    - ReplicationController
    - DaemonSet.apps
    - Deployment.apps
    - ReplicaSet.apps
    - StatefulSet.apps
    - Job.batch
    - PodDisruptionBudget.policy
goal:
  domain: k8s
  classes: [Pod]

{% func SelectorToPods(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	matchLabels := obj["spec"].(map[string]any)["selector"].(map[string]any)["matchLabels"]
	RequireAll(matchLabels)
%}
k8s:Pod:{"namespace":{%q= ns %},"labels":{%s= ToJSON(matchLabels) %}}
{% endfunc %}

# SelectorToLogs finds logs for pods matching the selector of a k8s workload resource.
name: SelectorToLogs
start:
  domain: k8s
  classes:
    - ReplicationController
    - DaemonSet.apps
    - Deployment.apps
    - ReplicaSet.apps
    - StatefulSet.apps
    - Job.batch
    - PodDisruptionBudget.policy
goal:
  domain: log

{% func SelectorToLogs(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	matchLabels := obj["spec"].(map[string]any)["selector"].(map[string]any)["matchLabels"]
	RequireAll(matchLabels)
%}
log:{%s= logTypeForNamespace(ns) %}:{"namespace":{%q= ns %},"labels":{%s= ToJSON(matchLabels) %}}
{% endfunc %}

# K8sSrcToNetflow finds netflows where the k8s resource is the source.
name: K8sSrcToNetflow
start:
  domain: k8s
  classes: [Node, Pod, Service]
goal:
  domain: netflow
  classes: [network]

{% func K8sSrcToNetflow(o interface{}) %}
{% code
	_, _, ns, name, kind := k8sMetadata(o)
	RequireAll(name, kind)
%}
netflow:network:{SrcK8S_Type={%q= kind %}, SrcK8S_Namespace={%q= ns %}} | json | SrcK8S_Name={%q= name %}
{% endfunc %}

# K8sSrcOwnerToNetflow finds netflows where the k8s owner resource is the source owner.
name: K8sSrcOwnerToNetflow
start:
  domain: k8s
  classes:
    - DaemonSet.apps
    - Deployment.apps
    - ReplicaSet.apps
    - StatefulSet.apps
goal:
  domain: netflow
  classes: [network]

{% func K8sSrcOwnerToNetflow(o interface{}) %}
{% code
	_, _, ns, name, _ := k8sMetadata(o)
	RequireAll(ns, name)
%}
netflow:network:{SrcK8S_Namespace={%q= ns %}, SrcK8S_OwnerName={%q= name %}}
{% endfunc %}

