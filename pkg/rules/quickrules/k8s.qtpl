{% func PVToPVC(o interface{}) %}
{% code
	obj := o.(map[string]any)
	ref := obj["spec"].(map[string]any)["claimRef"].(map[string]any)
%}
k8s:PersistentVolumeClaim:{"namespace":{%q= ref["namespace"].(string) %},"name":{%q= ref["name"].(string) %}}
{% endfunc %}

# PVToStorageClass finds the StorageClass for a PersistentVolume.
