# IngressToService finds Services referenced by an Ingress.
name: IngressToService
start:
  domain: k8s
  classes: [Ingress.networking.k8s.io]
goal:
  domain: k8s
  classes: [Service]

{% func IngressToService(o interface{}) %}
{% code
	_, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	svcNames := ingressServiceNames(o.(map[string]any))
%}
{% for _, name := range svcNames %}
k8s:Service:{"namespace":{%q= ns %},"name":{%q= name %}}
{% endfor %}
{% endfunc %}

# CSVToPartOf finds resources labeled app.kubernetes.io/part-of matching the CSV name (minus version).
name: CSVToPartOf
start:
  domain: k8s
  classes: [ClusterServiceVersion.v1alpha1.operators.coreos.com]
goal:
  domain: k8s
  classes:
    - Deployment.apps
    - DaemonSet.apps
    - StatefulSet.apps
    - Service
    - ConfigMap
    - Secret
    - ServiceAccount

{% func CSVToPartOf(o interface{}) %}
{% code
	_, _, ns, name, _ := k8sMetadata(o)
	RequireAll(ns, name)
	partOf := Require(csvPartOfName(name))
%}
k8s:Deployment.apps:{"namespace":{%q= ns %},"labels":{"app.kubernetes.io/part-of":{%q= partOf %}}}
k8s:DaemonSet.apps:{"namespace":{%q= ns %},"labels":{"app.kubernetes.io/part-of":{%q= partOf %}}}
k8s:StatefulSet.apps:{"namespace":{%q= ns %},"labels":{"app.kubernetes.io/part-of":{%q= partOf %}}}
k8s:Service:{"namespace":{%q= ns %},"labels":{"app.kubernetes.io/part-of":{%q= partOf %}}}
k8s:ConfigMap:{"namespace":{%q= ns %},"labels":{"app.kubernetes.io/part-of":{%q= partOf %}}}
k8s:Secret:{"namespace":{%q= ns %},"labels":{"app.kubernetes.io/part-of":{%q= partOf %}}}
k8s:ServiceAccount:{"namespace":{%q= ns %},"labels":{"app.kubernetes.io/part-of":{%q= partOf %}}}
{% endfunc %}

# HPAToTarget finds the scale target of a HorizontalPodAutoscaler.
name: HPAToTarget
start:
  domain: k8s
  classes: [HorizontalPodAutoscaler.autoscaling]
goal:
  domain: k8s

{% func HPAToTarget(o interface{}) %}
{% code
	_, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	obj := o.(map[string]any)
	ref := obj["spec"].(map[string]any)["scaleTargetRef"].(map[string]any)
	apiVersion, _ := ref["apiVersion"].(string)
	kind := ref["kind"].(string)
	name := ref["name"].(string)
	class := k8s.Class(schema.FromAPIVersionAndKind(apiVersion, kind))
%}
k8s:{%s= class.Name() %}:{"namespace":{%q= ns %},"name":{%q= name %}}
{% endfunc %}

# InstanceToOperands finds namespaced operand resources whose app.kubernetes.io/instance label matches the start object's name.
name: InstanceToOperands
start:
  domain: k8s
goal:
  domain: k8s
  classes:
    - Deployment.apps
    - DaemonSet.apps
    - StatefulSet.apps
    - ReplicaSet.apps
    - Service
    - ConfigMap
    - Secret
    - ServiceAccount
    - PersistentVolumeClaim
    - Job.batch
    - CronJob.batch
    - Role.rbac.authorization.k8s.io
    - RoleBinding.rbac.authorization.k8s.io
    - Ingress.networking.k8s.io
    - NetworkPolicy.networking.k8s.io
    - Route.v1.route.openshift.io

{% func InstanceToOperands(o interface{}) %}
{% code
	obj, _, ns, name, _ := k8sMetadata(o)
	RequireAll(ns, name)
	if !isCustomResource(obj) { Fail("not a custom resource") }
%}
