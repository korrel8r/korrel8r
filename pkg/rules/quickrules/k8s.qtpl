  classes: [network]

{% func K8sDstToNetflow(o interface{}) %}
{% code
	_, _, ns, name, kind := k8sMetadata(o)
	RequireAll(name, kind)
%}
netflow:network:{DstK8S_Type={%q= kind %}, DstK8S_Namespace={%q= ns %}} | json | DstK8S_Name={%q= name %}
{% endfunc %}

# K8sDstOwnerToNetflow finds netflows where the k8s owner resource is the destination owner.
name: K8sDstOwnerToNetflow
start:
  domain: k8s
  classes:
    - DaemonSet.apps
    - Deployment.apps
    - ReplicaSet.apps
    - StatefulSet.apps
goal:
  domain: netflow
  classes: [network]

{% func K8sDstOwnerToNetflow(o interface{}) %}
{% code
	_, _, ns, name, _ := k8sMetadata(o)
	RequireAll(ns, name)
%}
netflow:network:{DstK8S_Namespace={%q= ns %}, DstK8S_OwnerName={%q= name %}}
{% endfunc %}

# ServiceToPods finds Pods matching the selector of a k8s Service.
name: ServiceToPods
start:
  domain: k8s
  classes: [Service]
goal:
  domain: k8s
  classes: [Pod]

{% func ServiceToPods(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	selector := obj["spec"].(map[string]any)["selector"]
	RequireAll(selector)
%}
k8s:Pod:{"namespace":{%q= ns %},"labels":{%s= ToJSON(selector) %}}
{% endfunc %}

# EventToAll correlates a core v1 Event to the resource it references.
name: EventToAll
start:
  domain: k8s
  classes: [Event.v1]
goal:
  domain: k8s

{% func EventToAll(o interface{}) %}
{% code
	obj := o.(map[string]any)
	inv := obj["involvedObject"].(map[string]any)
	class := k8s.Class(schema.FromAPIVersionAndKind(inv["apiVersion"].(string), inv["kind"].(string)))
	ns, _ := inv["namespace"].(string)
	name := inv["name"].(string)
	RequireAll(name)
%}
{% if ns != "" %}
k8s:{%s= class.Name() %}:{"namespace":{%q= ns %},"name":{%q= name %}}
{% else %}
k8s:{%s= class.Name() %}:{"name":{%q= name %}}
{% endif %}
{% endfunc %}

# Event2ToAll correlates a events.k8s.io/v1 Event to the resource it references.
name: Event2ToAll
start:
  domain: k8s
  classes: [Event.v1.events.k8s.io]
goal:
  domain: k8s

{% func Event2ToAll(o interface{}) %}
{% code
	obj := o.(map[string]any)
	reg := obj["regarding"].(map[string]any)
	class := k8s.Class(schema.FromAPIVersionAndKind(reg["apiVersion"].(string), reg["kind"].(string)))
	ns, _ := reg["namespace"].(string)
	name := reg["name"].(string)
	RequireAll(name)
%}
{% if ns != "" %}
k8s:{%s= class.Name() %}:{"namespace":{%q= ns %},"name":{%q= name %}}
{% else %}
k8s:{%s= class.Name() %}:{"name":{%q= name %}}
{% endif %}
{% endfunc %}

# PodToPVC finds PersistentVolumeClaims referenced by a Pod's volumes.
name: PodToPVC
start:
  domain: k8s
  classes: [Pod]
goal:
  domain: k8s
  classes: [PersistentVolumeClaim]

{% func PodToPVC(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	volumes := mapSlice(obj["spec"].(map[string]any), "volumes")
%}
{% for _, v := range volumes %}
{% code vol := v.(map[string]any) %}
{% if pvc, ok := vol["persistentVolumeClaim"].(map[string]any); ok %}
k8s:PersistentVolumeClaim:{"namespace":{%q= ns %},"name":{%q= pvc["claimName"].(string) %}}
{% endif %}
{% endfor %}
{% endfunc %}

# PodToConfigMap finds ConfigMaps referenced by a Pod's volumes.
name: PodToConfigMap
start:
  domain: k8s
  classes: [Pod]
goal:
  domain: k8s
  classes: [ConfigMap]

{% func PodToConfigMap(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	volumes := mapSlice(obj["spec"].(map[string]any), "volumes")
%}
{% for _, v := range volumes %}
{% code vol := v.(map[string]any) %}
{% if cm, ok := vol["configMap"].(map[string]any); ok %}
k8s:ConfigMap:{"namespace":{%q= ns %},"name":{%q= cm["name"].(string) %}}
{% endif %}
{% endfor %}
{% endfunc %}

# PodToSecret finds Secrets referenced by a Pod's volumes.
name: PodToSecret
start:
  domain: k8s
  classes: [Pod]
goal:
  domain: k8s
  classes: [Secret]

{% func PodToSecret(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	volumes := mapSlice(obj["spec"].(map[string]any), "volumes")
%}
{% for _, v := range volumes %}
{% code vol := v.(map[string]any) %}
{% if sec, ok := vol["secret"].(map[string]any); ok %}
k8s:Secret:{"namespace":{%q= ns %},"name":{%q= sec["secretName"].(string) %}}
{% endif %}
{% endfor %}
{% endfunc %}

# PodToServiceAccount finds the ServiceAccount used by a Pod.
name: PodToServiceAccount
start:
  domain: k8s
  classes: [Pod]
goal:
  domain: k8s
  classes: [ServiceAccount]

{% func PodToServiceAccount(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	sa := Require(obj["spec"].(map[string]any)["serviceAccountName"].(string))
%}
k8s:ServiceAccount:{"namespace":{%q= ns %},"name":{%q= sa %}}
{% endfunc %}

# ServiceToEndpointSlice finds EndpointSlices for a Service.
name: ServiceToEndpointSlice
start:
  domain: k8s
  classes: [Service]
goal:
  domain: k8s
  classes: [EndpointSlice.discovery.k8s.io]

{% func ServiceToEndpointSlice(o interface{}) %}
{% code _, _, ns, name, _ := k8sMetadata(o); RequireAll(ns, name) %}
k8s:EndpointSlice.discovery.k8s.io:{"namespace":{%q= ns %},"labels":{"kubernetes.io/service-name":{%q= name %}}}
{% endfunc %}

# EndpointSliceToService finds the Service for an EndpointSlice.
name: EndpointSliceToService
start:
  domain: k8s
  classes: [EndpointSlice.discovery.k8s.io]
goal:
  domain: k8s
  classes: [Service]

{% func EndpointSliceToService(o interface{}) %}
{% code
	_, metadata, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	labels := metadata["labels"].(map[string]any)
	svcName := Require(labels["kubernetes.io/service-name"].(string))
%}
k8s:Service:{"namespace":{%q= ns %},"name":{%q= svcName %}}
{% endfunc %}

# PVCToPV finds the PersistentVolume bound to a PersistentVolumeClaim.
name: PVCToPV
start:
  domain: k8s
  classes: [PersistentVolumeClaim]
goal:
  domain: k8s
