# MetricToNode creates a k8s Node query from the node labels of a metric.
name: MetricToNode
start:
  domain: metric
  classes: [metric]
goal:
  domain: k8s
  classes: [Node]

{% func MetricToNode(o interface{}) %}
{% code
	m := o.(metric.Object)
	name := Default(m.Labels["node"], m.Labels["k8s_node_name"])
	RequireAll(name)
%}
k8s:Node:{"name":{%q= name %}}
{% endfunc %}
