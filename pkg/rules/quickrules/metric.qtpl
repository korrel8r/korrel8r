{% package quickrules %}

{% import "github.com/korrel8r/korrel8r/pkg/domains/metric" %}

# MetricToPod creates a k8s Pod query from the pod labels of a metric.
name: MetricToPod
start:
  domain: metric
  classes: [metric]
goal:
  domain: k8s
  classes: [Pod]

{% func MetricToPod(o interface{}) %}
{% code
	m := o.(metric.Object)
	ns := Default(m.Labels["namespace"], m.Labels["k8s_namespace_name"])
	name := Default(m.Labels["pod"], m.Labels["k8s_pod_name"])
	RequireAll(ns, name)
%}
k8s:Pod:{"namespace":{%q= ns %},"name":{%q= name %}}
{% endfunc %}

# MetricToDeployment creates a k8s Deployment query from the deployment labels of a metric.
name: MetricToDeployment
start:
  domain: metric
  classes: [metric]
goal:
  domain: k8s
  classes: [Deployment.apps]

{% func MetricToDeployment(o interface{}) %}
{% code
	m := o.(metric.Object)
	ns := Default(m.Labels["namespace"], m.Labels["k8s_namespace_name"])
	name := Default(m.Labels["deployment"], m.Labels["k8s_deployment_name"])
	RequireAll(ns, name)
%}
k8s:Deployment.apps:{"namespace":{%q= ns %},"name":{%q= name %}}
{% endfunc %}

