# MetricToStatefulSet creates a k8s StatefulSet query from the statefulset labels of a metric.
name: MetricToStatefulSet
start:
  domain: metric
  classes: [metric]
goal:
  domain: k8s
  classes: [StatefulSet.apps]

{% func MetricToStatefulSet(o interface{}) %}
{% code
	m := o.(metric.Object)
	ns := Default(m.Labels["namespace"], m.Labels["k8s_namespace_name"])
