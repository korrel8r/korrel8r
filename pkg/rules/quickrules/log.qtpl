{% package quickrules %}

{% import "github.com/korrel8r/korrel8r/pkg/domains/log" %}

# LogToPod creates a k8s Pod query from the pod attributes of a log entry.
name: LogToPod
start:
  domain: log
  classes: [application, infrastructure, audit]
goal:
  domain: k8s
  classes: [Pod]

{% func LogToPod(o interface{}) %}
{% code
	l := o.(log.Object)
	ns := Default(l["kubernetes_namespace_name"], l["k8s_namespace_name"])
  name := Default(l["kubernetes_pod_name"], l["k8s_pod_name"])
	RequireAll(ns, name)
%}
k8s:Pod:{"namespace":{%q= ns %},"name":{%q= name %}}
{% endfunc %}

# PodToLogs finds logs for a pod.
name: PodToLogs
start:
  domain: k8s
  classes: [Pod]
goal:
  domain: log

{% func PodToLogs(o interface{}) %}
{% code _, _, ns, name, _ := k8sMetadata(o); RequireAll(ns, name) %}
log:{%s= logTypeForNamespace(ns) %}:{"namespace":{%q= ns %},"name":{%q= name %}}
{% endfunc %}

# ServiceToLogs finds logs for pods selected by a service.
name: ServiceToLogs
start:
  domain: k8s
  classes: [Service]
goal:
  domain: log

{% func ServiceToLogs(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	selector := obj["spec"].(map[string]any)["selector"]
	RequireAll(selector)
%}
log:{%s= logTypeForNamespace(ns) %}:{"namespace":{%q= ns %},"labels":{%s= ToJSON(selector) %}}
{% endfunc %}
