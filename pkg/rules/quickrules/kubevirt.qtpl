	creds := mapSlice(obj["spec"].(map[string]any), "accessCredentials")
	names := kvSecretNames(volumes, creds)
	RequireAll(names)
%}
{% for _, n := range names %}
k8s:Secret:{"namespace":{%q= ns %},"name":{%q= n %}}
{% endfor %}
{% endfunc %}

