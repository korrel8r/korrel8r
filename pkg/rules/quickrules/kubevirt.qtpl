# VmExportToVm finds the source VirtualMachine of an export.
name: VmExportToVm
start:
  domain: k8s
  classes: [VirtualMachineExport.export.kubevirt.io]
goal:
  domain: k8s
  classes: [VirtualMachine.kubevirt.io]

{% func VmExportToVm(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	src := obj["spec"].(map[string]any)["source"].(map[string]any)
	if src["kind"].(string) != "VirtualMachine" { Fail("not a VirtualMachine export") }
%}
k8s:VirtualMachine.kubevirt.io:{"namespace":{%q= ns %},"name":{%q= src["name"].(string) %}}
{% endfunc %}

