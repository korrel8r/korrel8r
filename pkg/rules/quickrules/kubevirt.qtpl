  classes: [VirtualMachineSnapshot.snapshot.kubevirt.io]

{% func VmExportToVmSnapshot(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	src := obj["spec"].(map[string]any)["source"].(map[string]any)
	if src["kind"].(string) != "VirtualMachineSnapshot" { Fail("not a VirtualMachineSnapshot export") }
%}
k8s:VirtualMachineSnapshot.snapshot.kubevirt.io:{"namespace":{%q= ns %},"name":{%q= src["name"].(string) %}}
{% endfunc %}

