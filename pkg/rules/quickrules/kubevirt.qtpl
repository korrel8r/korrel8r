{% func NodeToVmi(o interface{}) %}
{% code _, _, _, name, _ := k8sMetadata(o); RequireAll(name) %}
k8s:VirtualMachineInstance.kubevirt.io:{"labels":{"kubevirt.io/nodeName":{%q= name %}}}
{% endfunc %}

# DataVolumeToImporterPod finds the CDI importer Pod for a DataVolume.
