{% package quickrules %}

{% import "strings" %}

# VmToVmi finds the VirtualMachineInstance for a VirtualMachine.
name: VmToVmi
start:
  domain: k8s
  classes: [VirtualMachine.kubevirt.io]
goal:
  domain: k8s
  classes: [VirtualMachineInstance.kubevirt.io]

{% func VmToVmi(o interface{}) %}
{% code _, _, ns, name, _ := k8sMetadata(o); RequireAll(ns, name) %}
k8s:VirtualMachineInstance.kubevirt.io:{"namespace":{%q= ns %},"name":{%q= name %}}
{% endfunc %}

# VmiToPod finds the virt-launcher Pod for a VirtualMachineInstance.
name: VmiToPod
start:
  domain: k8s
  classes: [VirtualMachineInstance.kubevirt.io]
goal:
  domain: k8s
  classes: [Pod]

{% func VmiToPod(o interface{}) %}
{% code _, _, ns, name, _ := k8sMetadata(o); RequireAll(ns, name) %}
k8s:Pod:{"namespace":{%q= ns %},"labels":{"kubevirt.io":"virt-launcher","vm.kubevirt.io/name":{%q= name %}}}
{% endfunc %}

# VmiToNode finds the Node a VirtualMachineInstance is scheduled on.
name: VmiToNode
start:
  domain: k8s
  classes: [VirtualMachineInstance.kubevirt.io]
goal:
  domain: k8s
  classes: [Node]

{% func VmiToNode(o interface{}) %}
{% code
	obj := o.(map[string]any)
	nodeName := Require(obj["status"].(map[string]any)["nodeName"].(string))
%}
k8s:Node:{"name":{%q= nodeName %}}
{% endfunc %}

# VmToPVC finds PersistentVolumeClaims referenced by a VirtualMachine.
name: VmToPVC
start:
  domain: k8s
  classes: [VirtualMachine.kubevirt.io]
goal:
  domain: k8s
  classes: [PersistentVolumeClaim]

{% func VmToPVC(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	spec := obj["spec"].(map[string]any)
	dvTemplates := mapSlice(spec, "dataVolumeTemplates")
	tmplSpec := spec["template"].(map[string]any)["spec"].(map[string]any)
	volumes := mapSlice(tmplSpec, "volumes")
%}
{% for _, t := range dvTemplates %}
{% code dvName := t.(map[string]any)["metadata"].(map[string]any)["name"].(string) %}
k8s:PersistentVolumeClaim:{"namespace":{%q= ns %},"name":{%q= dvName %}}
{% endfor %}
{% for _, v := range volumes %}
{% code vol := v.(map[string]any) %}
{% if pvc, ok := vol["persistentVolumeClaim"].(map[string]any); ok %}
k8s:PersistentVolumeClaim:{"namespace":{%q= ns %},"name":{%q= pvc["claimName"].(string) %}}
{% endif %}
{% if dv, ok := vol["dataVolume"].(map[string]any); ok %}
k8s:PersistentVolumeClaim:{"namespace":{%q= ns %},"name":{%q= dv["name"].(string) %}}
{% endif %}
{% if eph, ok := vol["ephemeral"].(map[string]any); ok %}
k8s:PersistentVolumeClaim:{"namespace":{%q= ns %},"name":{%q= eph["persistentVolumeClaim"].(map[string]any)["claimName"].(string) %}}
{% endif %}
{% if md, ok := vol["memoryDump"].(map[string]any); ok %}
k8s:PersistentVolumeClaim:{"namespace":{%q= ns %},"name":{%q= md["claimName"].(string) %}}
{% endif %}
{% endfor %}
{% endfunc %}

