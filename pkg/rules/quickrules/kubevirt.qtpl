start:
  domain: k8s
  classes: [DataVolume.cdi.kubevirt.io]
goal:
  domain: k8s
  classes: [Pod]

{% func DataVolumeToImporterPod(o interface{}) %}
{% code _, _, ns, name, _ := k8sMetadata(o); RequireAll(ns, name) %}
k8s:Pod:{"namespace":{%q= ns %},"labels":{"cdi.kubevirt.io/storage.import.importPvcName":{%q= name %}}}
{% endfunc %}

# VmToNetAttachDef finds NetworkAttachmentDefinitions referenced by a VirtualMachine.
name: VmToNetAttachDef
start:
  domain: k8s
  classes: [VirtualMachine.kubevirt.io]
goal:
  domain: k8s
  classes: [NetworkAttachmentDefinition.k8s.cni.cncf.io]

{% func VmToNetAttachDef(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	networks := mapSlice(obj["spec"].(map[string]any)["template"].(map[string]any)["spec"].(map[string]any), "networks")
%}
{% for _, n := range networks %}
{% code net := n.(map[string]any) %}
{% if m, ok := net["multus"].(map[string]any); ok %}
{% code netName := m["networkName"].(string) %}
{% if !strings.Contains(netName, "/") %}
k8s:NetworkAttachmentDefinition.k8s.cni.cncf.io:{"namespace":{%q= ns %},"name":{%q= netName %}}
{% endif %}
{% endif %}
{% endfor %}
{% endfunc %}

# VmiToNetAttachDef finds NetworkAttachmentDefinitions referenced by a VirtualMachineInstance.
name: VmiToNetAttachDef
start:
  domain: k8s
  classes: [VirtualMachineInstance.kubevirt.io]
goal:
  domain: k8s
  classes: [NetworkAttachmentDefinition.k8s.cni.cncf.io]

{% func VmiToNetAttachDef(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	networks := mapSlice(obj["spec"].(map[string]any), "networks")
%}
{% for _, n := range networks %}
{% code net := n.(map[string]any) %}
{% if m, ok := net["multus"].(map[string]any); ok %}
{% code netName := m["networkName"].(string) %}
{% if !strings.Contains(netName, "/") %}
k8s:NetworkAttachmentDefinition.k8s.cni.cncf.io:{"namespace":{%q= ns %},"name":{%q= netName %}}
{% endif %}
{% endif %}
{% endfor %}
{% endfunc %}

# VmToSecret finds Secrets referenced by a VirtualMachine's volumes and accessCredentials.
name: VmToSecret
start:
  domain: k8s
  classes: [VirtualMachine.kubevirt.io]
goal:
  domain: k8s
  classes: [Secret]

{% func VmToSecret(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	tmplSpec := obj["spec"].(map[string]any)["template"].(map[string]any)["spec"].(map[string]any)
	volumes := mapSlice(tmplSpec, "volumes")
	creds := mapSlice(tmplSpec, "accessCredentials")
	names := kvSecretNames(volumes, creds)
	RequireAll(names)
%}
{% for _, n := range names %}
k8s:Secret:{"namespace":{%q= ns %},"name":{%q= n %}}
{% endfor %}
{% endfunc %}

