# VmToInstancetype finds the instancetype or cluster instancetype for a VirtualMachine.
name: VmToInstancetype
start:
  domain: k8s
  classes: [VirtualMachine.kubevirt.io]
goal:
  domain: k8s

{% func VmToInstancetype(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	it := obj["spec"].(map[string]any)["instancetype"].(map[string]any)
	name := Require(it["name"].(string))
	kind, _ := it["kind"].(string)
%}
{% if kind == "VirtualMachineInstancetype" %}
k8s:VirtualMachineInstancetype.instancetype.kubevirt.io:{"namespace":{%q= ns %},"name":{%q= name %}}
{% else %}
k8s:VirtualMachineClusterInstancetype.instancetype.kubevirt.io:{"name":{%q= name %}}
{% endif %}
{% endfunc %}

# VmToPreference finds the preference or cluster preference for a VirtualMachine.
name: VmToPreference
start:
  domain: k8s
  classes: [VirtualMachine.kubevirt.io]
goal:
  domain: k8s

{% func VmToPreference(o interface{}) %}
{% code
	obj, _, ns, _, _ := k8sMetadata(o)
	RequireAll(ns)
	pref := obj["spec"].(map[string]any)["preference"].(map[string]any)
	name := Require(pref["name"].(string))
	kind, _ := pref["kind"].(string)
%}
{% if kind == "VirtualMachinePreference" %}
k8s:VirtualMachinePreference.instancetype.kubevirt.io:{"namespace":{%q= ns %},"name":{%q= name %}}
{% else %}
k8s:VirtualMachineClusterPreference.instancetype.kubevirt.io:{"name":{%q= name %}}
{% endif %}
{% endfunc %}
