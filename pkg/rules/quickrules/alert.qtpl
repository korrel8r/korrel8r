{% func PodToLokiAlert(o interface{}) %}
{% code _, _, ns, name, _ := k8sMetadata(o); RequireAll(ns, name) %}
alert:alert:{"namespace":{%q= ns %},"kubernetes_pod_name":{%q= name %}}
{% endfunc %}

