#!/usr/bin/env bash
# Capture repeatable server-side measurements for one REST neighborhood traversal.
# Calibration procedure: doc/dev/traversal-memory.md
# Usage: hack/profile-traversal URL OUTPUT-DIRECTORY -- [neighbors flags]
set -euo pipefail

if (($# < 3)) || [[ $3 != -- ]]; then
    echo "usage: $0 URL OUTPUT-DIRECTORY -- [neighbors flags]" >&2
    exit 2
fi

url=${1%/}
output=$2
shift 3
sample_seconds=${SAMPLE_SECONDS:-0.1}
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
client="$root/../client/korrel8rcli"

# Use the active OpenShift login for both traversal and profiling requests.
token=$(oc whoami -t)
profile_headers=(-H "Authorization: Bearer $token")

if [[ ! -x $client ]]; then
    echo "client executable not found: $client; build it in ../client first" >&2
    exit 2
fi

mkdir -p "$output"
{
    echo "# Traversal profile capture"
    echo "# Date: $(date --iso-8601=seconds)"
    echo "# URL: $url"
    # Do not record arguments: they may contain credentials or sensitive objects.
    echo "# Client: $client"
    echo "# Git revision: $(git rev-parse HEAD 2>/dev/null || echo unknown)"
    echo "# Sample seconds: $sample_seconds"
} >"$output/README.txt"

# Publish only complete gzip profiles, so interrupted/failed downloads are not
# mistaken for usable snapshots. Temporary files do not match heap-*.prof.
capture_heap() {
    local destination=$1 temporary
    temporary=$(mktemp "$output/.heap-XXXXXX") || return 1
    if curl --fail --silent --show-error "${profile_headers[@]}" \
        "$url/debug/pprof/heap" >"$temporary" && gzip -t "$temporary"; then
        mv "$temporary" "$destination"
    else
        rm -f "$temporary"
        echo "discarded incomplete heap capture: $destination" >&2
        return 1
    fi
}

# The server must be otherwise quiet: these counters are process-wide.
curl --fail --silent --show-error "$url/metrics" >"$output/metrics-before.prom"
capture_heap "$output/heap-before.prof"

"$client" neighbors "$@" --bearer-token "$token" --url "$url" --output json >"$output/graph.json" &
request_pid=$!

sample=0
while kill -0 "$request_pid" 2>/dev/null; do
    printf -v name '%04d' "$sample"
    # Heap snapshots intentionally do not request gc=1: forcing GC changes the
    # peak being measured. Failed heap captures are discarded.
    curl --silent --show-error "$url/metrics" >"$output/metrics-$name.prom" || true
    capture_heap "$output/heap-$name.prof" || true
    sample=$((sample + 1))
    printf '.' >&2
    sleep "$sample_seconds"
done
printf '\n' >&2
request_status=0
wait "$request_pid" || request_status=$?

curl --fail --silent --show-error "$url/metrics" >"$output/metrics-after.prom"

if ((request_status != 0)); then
    echo "traversal request failed; response may be incomplete: $output/graph.json" >&2
    exit "$request_status"
fi

echo "capture written to $output"
echo "inspect one snapshot: go tool pprof -sample_index=inuse_space -top $output/heap-before.prof"
echo "choose individual heap-NNNN.prof snapshots; passing multiple profiles merges them"
echo "compare counter deltas in metrics-before.prom and metrics-after.prom"
